# secrets — see SECURITY.md §2 (never commit; use .env.example)
.env
*.env
!.env.example
secrets/
secrets.env
*.pem
*.p8
*.p12
*.keystore
*.jks

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# runtime
node_modules/
__pycache__/
*.pyc
dist/
# build/ is the Vercel deploy dir (served as-is, no build step) — track build/combis,
# ignore the rest of build/.
build/*
!build/combis/

# large raw scrape artifacts stay reproducible via scripts, but we DO commit
# the tehuacan dataset (source sites may die; provenance > repo size).

# wrangler local dev
.dev.vars
.wrangler/
# admin app checkout — its own repo: github.com/augmentedmike/mitehuacan-admin
/admin/
resources/poi/denue_puebla.csv
.vercel
# local agent run logs — never committed
.agent-runs/
.agent-auth/
resources/discovery/

# generated sticker sheets (regeneratable via 22_sticker_sheet.py)
resources/stickers/*.pdf
resources/stickers/*-preview.png

# local Claude Code state — keep committed skills, ignore transient worktrees/settings
.claude/worktrees/
.claude/settings.local.json
