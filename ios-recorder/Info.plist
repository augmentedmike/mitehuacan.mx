<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- A launch screen (even empty) makes iOS show an instant system splash instead
	     of a black void until the first SwiftUI frame renders. Without this key the
	     app shows a black screen during launch. -->
	<key>UILaunchScreen</key>
	<dict/>

	<!-- Shown when the app first asks to use location (foreground). -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Graba el recorrido del combi mientras usas la app.</string>

	<!-- Shown when asking for Always — required to keep recording with the screen locked. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Permite seguir grabando el recorrido aunque el teléfono esté bloqueado o la app en segundo plano.</string>

	<!-- Legacy key some iOS versions still read. -->
	<key>NSLocationAlwaysUsageDescription</key>
	<string>Permite seguir grabando el recorrido aunque el teléfono esté bloqueado.</string>

	<!-- Shown when scanning a sticker QR in the Stickers admin. -->
	<key>NSCameraUsageDescription</key>
	<string>Escanea el código QR de una calcomanía para registrar dónde se colocó.</string>

	<!-- THE critical one: lets Core Location deliver fixes while backgrounded. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
	</array>
</dict>
</plist>
